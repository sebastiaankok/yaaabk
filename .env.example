# Copy to .env for local development. All values shown are the defaults.

# --- Backend ---
PORT=3000
# Directory holding the SQLite database file.
YAAABK_DATA_DIR=./data
# HS256 secret for signing session cookies (at least 32 characters). Generate
# one with `openssl rand -base64 48`. Required in production; in development an
# ephemeral secret is generated and printed as a warning.
YAAABK_AUTH_SECRET=
# Origin allowed to call the API with credentials (the frontend).
YAAABK_WEB_ORIGIN=http://localhost:5173

# --- Projects (GitHub) ---
# Preferred: configure these in the Settings page (stored encrypted in the
# database). These environment variables are the fallback when no credential
# is stored there.
# Token with permission to create repositories. A personal access token needs
# the `repo` scope; a GitHub App installation token needs `administration:write`.
YAAABK_GITHUB_TOKEN=
# Account new Project repositories are created under.
YAAABK_GITHUB_OWNER=
# Whether that account is an `org` or the authenticated `user`. Defaults to org.
YAAABK_GITHUB_OWNER_TYPE=org

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
PUBLIC_API_BASE_URL=http://localhost:3000

# --- Cost Control (OpenRouter) ---
# Preferred: configure this in the Settings page (stored encrypted in the
# database). These environment variables are the fallback when no credential
# is stored there.
# Management API key used to provision a budgeted sub-key per issue.
# Create one at https://openrouter.ai/settings/management-keys
OPENROUTER_MANAGEMENT_KEY=
# Default per-issue budget in cents ($0.50). A per-issue override is capped at
# $5.00 by the Cost Control Module.
YAAABK_DEFAULT_ISSUE_BUDGET_CENTS=50

# --- Agents ---
# Container image the per-issue agent Jobs run. Pin a version; `latest` is
# rejected by the cluster's policy.
YAAABK_AGENT_IMAGE=yaaabk/agent:0.1.0
# Base URL an agent Job reports its result back to. Must be reachable from the
# Project namespace; without it agents still run but their PR URLs are not
# recorded.
YAAABK_API_URL=
# How often the Agent Manager reconciles in-flight Jobs, in milliseconds.
YAAABK_AGENT_POLL_MS=15000

# --- CI Tracker ---
# How often the CI Tracker watches `automerge` pull requests, in milliseconds.
# It merges passing pull requests and spawns fix attempts on failing ones.
YAAABK_CI_POLL_MS=30000
