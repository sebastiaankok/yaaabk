{
  "name": "yaaabk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '@yaaabk/backend' --filter '@yaaabk/frontend' --parallel dev",
    "build": "bun run --filter '*' --if-present build",
    "test": "bun run --filter '*' --if-present test:unit",
    "test:e2e": "bun run --filter '@yaaabk/frontend' --if-present test:e2e",
    "test:e2e:install": "bun run --filter '@yaaabk/frontend' --if-present test:e2e:install",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.10.1",
    "typescript-eslint": "^8.72.2"
  }
}
