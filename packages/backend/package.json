{
  "name": "@yaaabk/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yaaabk/agents": "workspace:*",
    "@yaaabk/auth": "workspace:*",
    "@yaaabk/ci-tracker": "workspace:*",
    "@yaaabk/github": "workspace:*",
    "@yaaabk/grill-me": "workspace:*",
    "@yaaabk/issues": "workspace:*",
    "@yaaabk/k8s": "workspace:*",
    "@yaaabk/plans": "workspace:*",
    "@yaaabk/projects": "workspace:*",
    "@yaaabk/settings": "workspace:*",
    "@yaaabk/shared": "workspace:*",
    "@yaaabk/template": "workspace:*",
    "hono": "^4.11.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
